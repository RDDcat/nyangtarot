{
  "name": "nyang-tarot-icebreaking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate": "node --experimental-strip-types scripts/validate-data.ts",
    "art": "esbuild scripts/render-art.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=node_modules/.tmp/render-art-$$.mjs --log-level=warning && node node_modules/.tmp/render-art-$$.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
